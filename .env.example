# MongoDB (Prisma datasource)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/taskapp?retryWrites=true&w=majority"

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"

# Web Push (required for push notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_EMAIL="mailto:you@example.com"

# App mode
NODE_ENV="development"

# AI assistant (optional — the rest of the app works without it)
# Keys are server-side only; never expose them to the browser.
AI_PROVIDER="groq"                 # groq | anthropic
GROQ_API_KEY="replace-with-groq-api-key"
# ANTHROPIC_API_KEY="replace-with-anthropic-api-key"   # when AI_PROVIDER="anthropic"
# AI_MODEL=                        # default: llama-3.3-70b-versatile (groq) / claude-opus-5-5 (anthropic)
# AI_EFFORT="medium"               # anthropic only: low | medium | high | xhigh | max
# AI_REFUSAL_FALLBACK="default"    # anthropic only: default | off
AI_TIMEZONE="UTC"                  # IANA zone used to resolve "today", "friday", ...
AI_APPROVAL_MODE="always"          # always | single_reversible
# Limits (defaults shown)
# AI_MAX_MODEL_CALLS=6
# AI_MAX_TOOL_CALLS=12
# AI_REQUEST_TIMEOUT_MS=90000
# AI_PROVIDER_RETRIES=1
# AI_MAX_OUTPUT_TOKENS=8192        # default 8192 (groq) / 16000 (anthropic)
# AI_HISTORY_MESSAGES=12
# AI_STORED_MESSAGES=60
# AI_MAX_MESSAGE_CHARS=4000
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_PROPOSAL_TTL_MINUTES=1440
# AI_SPRINT_LENGTH_DAYS=14
# AI_DUE_SOON_DAYS=3
# AI_STALE_DAYS=7
# AI_OVERLOAD_THRESHOLD=5

# Tests: a disposable MongoDB replica-set database whose name contains "test".
# It is wiped by the integration tests.
# TEST_DATABASE_URL="mongodb://127.0.0.1:27017/taskforge_test?replicaSet=rs0&directConnection=true"
